      u : Array[1..4, 1..20, 1..1] of Real;
      V : Array[1..12, 1..20, 1..1] of Real;
      Theta : Array[1..3, 1..80, 1..1] of Real;
      Theta_prim : Array[1..3, 1..1, 1..80] of Real;
      y_hat : Array[1..3, 1..1, 1..1] of Real;
      eps : Array[1..3, 1..1, 1..1] of Real;
      V_diff : Array[1..3, 1..80, 1..1] of Real;
      norm_u_sq : Array[1..1, 1..1] of Real;
      y0 : Array[1..3, 1..20, 1..1] of Real;
      y0_work : Array[1..20, 1..1] of Real;
      Y0_all : Array[1..60, 1..1] of Real;
      W_all : Array[1..60, 1..1] of Real;
      Q { ExternalWritable := 'False'} : Array[1..12, 1..20, 1..1] of Real;
      Q_all : Array[1..60, 1..4] of Real;
      Q_all_prim : Array[1..4, 1..60] of Real;
      R : Array[1..4, 1..4] of Real;
      w : Array[1..3, 1..20, 1..1] of Real;
      w_sub_y0 : Array[1..60, 1..1] of Real;
      Q_primQ : Array[1..4, 1..4] of Real;
      inverted : Array[1..4, 1..4] of Real;
      duze : Array[1..4, 1..60] of Real;
      close : Array[1..4, 1..1] of Real;
      V2j { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Array[1..20, 1..20] of Real;
      dU { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Array[1..20, 1..1] of Real;
      h_temp { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Array[1..20, 1..1] of Real;
      rozrzut_u : Array[1..4, 1..1] of Real;
   END_VAR


BEGIN

END_DATA_BLOCK

FUNCTION "MatrixIdentity" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      lb : DInt;
      ub : DInt;
   END_VAR

   VAR_OUTPUT 
      C : Array[*, *] of Real;
   END_VAR

   VAR_TEMP 
      i : DInt;
   END_VAR


BEGIN
	
	
	"MatrixFilled"(lb_1 := #lb,
	               ub_1 := #ub,
	               lb_2 := #lb,
	               ub_2 := #ub,
	               val := 0.0,
	               C => #C);
	FOR #i := #lb TO #ub DO
	    #C[#i, #i] := 1;
	END_FOR;
	
	
	
END_FUNCTION

DATA_BLOCK "aMPCconfig"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
NON_RETAIN
   VAR 
      H : Int;
      L : Int;
      nV : Int;
      kappa : Real;
      prog_szumu : Real;
      gamma : Real;
      ro : Array[1..4, 1..1] of Real;
      aMPC_init : Bool;
      czy_pobudzenie : Bool;
   END_VAR


BEGIN
   H := 20;
   L := 1;
   nV := 20;
   kappa := 1.0;
   prog_szumu := 0.5;
   gamma := 0.01;
   ro[1,1] := 24000.0;
   ro[2,1] := 18000.0;
   ro[3,1] := 18000.0;
   ro[4,1] := 18000.0;

END_DATA_BLOCK

